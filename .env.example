# Canairy - Environment Variables Configuration
#
# Anything starting with VITE_ is built into the website and visible to every
# visitor. Never put a secret key in a VITE_ variable.

# ── Frontend (Vite) ──
VITE_API_URL=http://localhost:5555/api/v1

# ── Backend ──
PORT=5555

# Where readings are stored. Leave unset locally to use data/canairy.db (SQLite).
# In production, a Postgres URL: postgres://user:pass@host:5432/canairy
DATABASE_URL=

# Protects GET /api/cron/collect for schedulers that call a URL (e.g. Vercel Cron).
# Leave unset to disable that endpoint; the CLI (python -m api.collect) doesn't need it.
CRON_SECRET=

# ── Data source keys (used only by the collector job) ──

# FRED (free: https://fred.stlouisfed.org/docs/api/api_key.html)
# Grocery prices, gas, oil, mortgage rates, jobless claims, GDP, bank data
FRED_API_KEY=your_fred_api_key_here

# EIA (free: https://www.eia.gov/opendata/register.php)
# Strategic Petroleum Reserve level; hidden until this is set
EIA_API_KEY=

# Everything else (CISA, FEMA, FDA, NWS, TSA, Treasury, FDIC, State Dept,
# WHO, Freightos, Yahoo Finance) needs no key.

# ── Daily briefing (server-side Claude call, at most 4/day) ──
# Server-only: never prefix with VITE_. Use a key in a dedicated workspace with a monthly spend limit.
BRIEFING_ENABLED=false
ANTHROPIC_API_KEY=
# Needed only if the key isn't scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
